{
  "schema_version": 1,
  "training": {
    "schema_version": 1,
    "variant": "hybrid_geometry",
    "seeds": [42, 43],
    "train_samples_per_arm": 5000,
    "epochs": 12,
    "batch_size": 64,
    "evaluation_batch_size": 64,
    "num_workers": 2,
    "epoch_dev_samples": 2048,
    "learning_rate": 0.00005,
    "encoder_learning_rate": 0.000005,
    "weight_decay": 0.001,
    "warmup_epochs": 2,
    "minimum_lr_factor": 0.05,
    "mixed_precision": true,
    "latency_warmup": 16,
    "latency_samples": 128,
    "representative_seed_policy": "minimum-paired-epoch-dev-loss"
  },
  "appearance": {
    "brightness": 0.35,
    "contrast": 0.25,
    "blur_probability": 0.35,
    "blur_sigma": 1.0,
    "noise_probability": 0.35,
    "noise_std": 5.0
  },
  "training_selection": "central_only",
  "epoch_dev_views": ["clean", "dim", "bright", "blur", "noise"],
  "view_selection_policy": "equal-weight-fixed-development-views"
}
